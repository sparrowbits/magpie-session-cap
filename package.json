{
  "name": "magpie-session-cap",
  "version": "1.0.2",
  "description": "magpie Responses middleware that best-effort rotates prompt_cache_key and folds older Codex turns into a quoted user-context digest while preserving recent history and media parts.",
  "type": "module",
  "main": "./session-cap.middleware.js",
  "exports": {
    ".": "./session-cap.middleware.js"
  },
  "files": [
    "session-cap.middleware.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "magpie-plugin",
    "gateway",
    "middleware",
    "codex",
    "opencode",
    "claude-code",
    "prompt_cache_key",
    "session_request_limit_exceeded",
    "session_turn_limit_exceeded",
    "relay",
    "xingchiapi"
  ],
  "license": "MIT",
  "author": "sparrowbits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparrowbits/magpie-session-cap.git"
  },
  "homepage": "https://github.com/sparrowbits/magpie-session-cap#readme",
  "bugs": {
    "url": "https://github.com/sparrowbits/magpie-session-cap/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "magpie": {
    "middleware": "./session-cap.middleware.js",
    "name": "Session Cap",
    "summary": {
      "en": "Keep Codex Responses conversations inside relay per-session caps by rolling prompt_cache_key and folding older turns into a quoted user-context digest.",
      "zh": "在 Responses 请求中轮换 prompt_cache_key，并把旧轮次折叠为带引用标记的普通 user 上下文；保留近期轮次并限制请求体大小。"
    },
    "options": {
      "providers": [
        "xingchiapi"
      ],
      "keepTurns": 9,
      "fold": true,
      "foldTarget": "user"
    }
  }
}
